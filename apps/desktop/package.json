{
  "name": "@sciloop/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json",
    "start": "electron .",
    "dev:web": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@sciloop/core": "0.1.0",
    "@sciloop/harness": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.0"
  }
}
